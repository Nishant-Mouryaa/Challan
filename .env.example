# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public-anon-key>

# Razorpay test mode (server-side only, except the public checkout key ID)
RAZORPAY_KEY_ID=rzp_test_<key-id>
RAZORPAY_KEY_SECRET=<test-key-secret>
RAZORPAY_PLAN_STARTER_ID=<monthly-starter-plan-id>
RAZORPAY_PLAN_BUSINESS_ID=<monthly-business-plan-id>
RAZORPAY_WEBHOOK_SECRET=<webhook-signing-secret>

# Optional: email address shown for Enterprise plan inquiries
NEXT_PUBLIC_SUPPORT_EMAIL=<support-email>